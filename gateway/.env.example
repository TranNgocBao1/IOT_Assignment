# Sao chép thành .env rồi điền giá trị thật:   cp .env.example .env
# .env nằm trong .gitignore — KHÔNG commit.

# Địa chỉ Node M trong LAN (IP cố định qua DHCP reservation).
# Khi chưa có board: chạy mock_node_m.py và đặt NODE_M_URL=http://127.0.0.1:5000
NODE_M_URL=http://192.168.1.50

# CoreIOT — device "air-gateway" (KHÁC token của Node M)
COREIOT_HOST=app.coreiot.io
COREIOT_PORT=1883
GATEWAY_TOKEN=DAN_TOKEN_AIR_GATEWAY

POLL_INTERVAL_S=5
DATA_DIR=data
